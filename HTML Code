<!--
  * CTMUN Parley Pro 3.0 *
  
  A single-file conference timer for Model UN committees. 
  Supports three caucus formats:
    • Moderated Caucus   — total time budget + per-speaker timer
    • Unmoderated Caucus — simple countdown
    • Speaker's List     — round-robin with a fixed speaker count

  There are no dependencies beyond Google Fonts. Includes keyboard shortcuts!
-->


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CTMUN Parley 3.0</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f5f3ee;
    --card: #eceae3;
    --card-border: #d8d4c8;
    --text: #1a1a18;
    --text-muted: #7a7870;
    --accent: #c0392b;
    --accent2: #1a3a5c;
    --btn: #1a1a18;
    --btn-text: #f5f3ee;
    --btn-muted: #d8d4c8;
    --btn-muted-text: #4a4a48;
    --timer-bg: #1a1a18;
    --timer-text: #f5f3ee;
    --green: #2e7d32;
    --danger: #ff4d4d;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 1rem 2rem;
  }

  .card {
    background: var(--card);
    border: 1.5px solid var(--card-border);
    border-radius: 14px;
    padding: 1.1rem 1.25rem;
    width: 100%;
    max-width: 620px;
    margin-top: 1rem;
  }

  .card-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    color: var(--text);
    border-bottom: 1.5px solid var(--card-border);
    padding-bottom: 0.6rem;
    margin-bottom: 0.8rem;
    text-align: center;
  }

  .caucus-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .caucus-btn {
    background: transparent;
    border: none;
    padding: 0.65rem 0.75rem;
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.15s, transform 0.1s;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .caucus-btn:hover {
    background: rgba(0,0,0,0.05);
    transform: translateX(3px);
  }

  .caucus-btn .label { flex: 1; }
  .caucus-btn .arrow { color: var(--text-muted); font-size: 1.1rem; }

  .divider {
    border: none;
    border-top: 1.5px solid var(--card-border);
    margin: 0.1rem 0;
  }

  .form-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.65rem;
  }

  .form-row label {
    font-weight: 500;
    font-size: 0.85rem;
    min-width: 100px;
    color: var(--text);
  }

  input[type="text"], input[type="number"] {
    background: #fff;
    border: 1.5px solid var(--card-border);
    border-radius: 7px;
    padding: 0.4rem 0.7rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.15s;
  }

  input[type="text"]:focus, input[type="number"]:focus {
    border-color: var(--accent2);
  }

  input[type="text"] { flex: 1; }
  input[type="number"] {
    width: 60px;
    text-align: center;
    -moz-appearance: textfield;
  }
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; }

  .time-sep {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .time-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border: none;
    border-radius: 7px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
    white-space: nowrap;
  }

  .btn:hover { opacity: 0.85; transform: translateY(-1px); }
  .btn:active { transform: translateY(0); }

  .btn-primary { background: var(--btn); color: var(--btn-text); }
  .btn-muted { background: var(--btn-muted); color: var(--btn-muted-text); }
  .btn-accent { background: var(--accent); color: #fff; }
  .btn-green { background: var(--green); color: #fff; }

  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .timer-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.7rem;
  }

  .timer-display {
    background: var(--timer-bg);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    text-align: center;
  }

  .timer-btn-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .timer-btn-col .btn {
    width: 120px;
  }

  .timer-speaker {
    font-size: 0.7rem;
    font-weight: 500;
    color: #aaa;
    margin-bottom: 0.15rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .timer-count {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 9vw, 4.5rem);
    letter-spacing: 0.04em;
    color: var(--timer-text);
    line-height: 1;
  }

  /* Flashing effect */
  @keyframes flash-red {
    0%, 100% { color: var(--timer-text); }
    50% { color: var(--danger); }
  }

  .critical-time {
    animation: flash-red 0.5s infinite;
    color: var(--danger) !important;
  }

  .timer-status {
    font-size: 0.72rem;
    color: #888;
    margin-top: 0.25rem;
    font-style: italic;
  }

  .timer-status.running { color: #6fc36f; }
  .timer-status.paused  { color: #f0a860; }
  .timer-status.done    { color: var(--accent); }

  .speaker-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.3rem;
  }

  .speaker-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem;
    letter-spacing: 0.04em;
  }

  .speaker-lbl {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .topic-tag {
    display: inline-block;
    background: var(--accent2);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 0.4rem;
  }

  .page { display: none; }
  .page.active { display: block; }

  .fade-in { animation: fadeIn 0.2s ease; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .error-msg {
    color: var(--accent);
    font-size: 0.78rem;
    margin-top: 0.35rem;
    display: none;
  }
</style>
</head>
<body>

<div class="page active fade-in" id="page-home">
  <div class="card">
    <div class="card-title">CTMUN Parley 3.0</div>
    <div class="caucus-list">
      <button class="caucus-btn" onclick="showPage('page-mod-setup')">
        <span class="label">Moderated Caucus</span>
        <span class="arrow">›</span>
      </button>
      <hr class="divider">
      <button class="caucus-btn" onclick="showPage('page-unmod-setup')">
        <span class="label">Unmoderated Caucus</span>
        <span class="arrow">›</span>
      </button>
      <hr class="divider">
      <button class="caucus-btn" onclick="showPage('page-rr-setup')">
        <span class="label">Speaker's List / Round Robin</span>
        <span class="arrow">›</span>
      </button>
    </div>
  </div>
</div>

<div class="page" id="page-mod-setup">
  <div class="card fade-in">
    <div class="card-title">Moderated Caucus</div>
    <div class="form-row">
      <label>Topic:</label>
      <input type="text" id="mod-topic" placeholder="Topic">
    </div>
    <div class="form-row">
      <label>Total Time:</label>
      <input type="number" id="mod-total-m" min="0" max="99" placeholder="0">
      <span class="time-sep">m</span>
      <input type="number" id="mod-total-s" min="0" max="59" placeholder="0">
      <span class="time-label">s</span>
    </div>
    <div class="form-row">
      <label>Speaking Time:</label>
      <input type="number" id="mod-speak-m" min="0" max="99" placeholder="0">
      <span class="time-sep">m</span>
      <input type="number" id="mod-speak-s" min="0" max="59" placeholder="0">
      <span class="time-label">s</span>
    </div>
    <div class="error-msg" id="mod-error">Valid times required (total > 0).</div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="startModerated()">Submit</button>
      <button class="btn btn-muted" onclick="goHome()">← Back</button>
    </div>
  </div>
</div>

<div class="page" id="page-mod-timer">
  <div class="card fade-in">
    <div class="card-title">Moderated Caucus</div>
    <span id="mod-topic-tag" class="topic-tag"></span>
    <div class="speaker-row">
      <span class="speaker-num" id="mod-speaker-num">—</span>
      <span class="speaker-lbl" id="mod-speaker-label">Speaker</span>
    </div>
    <div class="timer-layout">
      <div class="timer-display">
        <div class="timer-speaker">Speaking Time</div>
        <div class="timer-count" id="mod-speak-display">01:00</div>
        <div class="timer-status paused" id="mod-speak-status">Paused</div>
      </div>
      <div class="timer-btn-col">
        <button class="btn btn-primary" id="mod-start-btn" onclick="toggleModTimer()">Start</button>
        <button class="btn btn-muted" onclick="resetModSpeaker()">Reset</button>
        <button class="btn btn-accent" onclick="nextModSpeaker()">Next ›</button>
        <button class="btn btn-muted" onclick="newCaucus()">↩ New</button>
      </div>
    </div>
  </div>
</div>

<div class="page" id="page-unmod-setup">
  <div class="card fade-in">
    <div class="card-title">Unmoderated Caucus</div>
    <div class="form-row">
      <label>Total Time:</label>
      <input type="number" id="unmod-m" min="0" max="99" placeholder="0">
      <span class="time-sep">m</span>
      <input type="number" id="unmod-s" min="0" max="59" placeholder="0">
      <span class="time-label">s</span>
    </div>
    <div class="error-msg" id="unmod-error">Valid time required (must be > 0).</div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="startUnmod()">Submit</button>
      <button class="btn btn-muted" onclick="goHome()">← Back</button>
    </div>
  </div>
</div>

<div class="page" id="page-unmod-timer">
  <div class="card fade-in">
    <div class="card-title">Unmoderated Caucus</div>
    <div class="timer-layout">
      <div class="timer-display">
        <div class="timer-speaker">Time Remaining</div>
        <div class="timer-count" id="unmod-display">10:00</div>
        <div class="timer-status paused" id="unmod-status">Paused</div>
      </div>
      <div class="timer-btn-col">
        <button class="btn btn-primary" id="unmod-start-btn" onclick="toggleUnmod()">Start</button>
        <button class="btn btn-muted" onclick="resetUnmod()">Reset</button>
        <button class="btn btn-muted" onclick="newCaucus()">↩ New</button>
      </div>
    </div>
  </div>
</div>

<div class="page" id="page-rr-setup">
  <div class="card fade-in">
    <div class="card-title">Speaker's List / Round Robin</div>
    <div class="form-row">
      <label>Topic:</label>
      <input type="text" id="rr-topic" placeholder="Topic">
    </div>
    <div class="form-row">
      <label>Total Speakers:</label>
      <input type="number" id="rr-speakers" min="1" max="200" placeholder="0">
    </div>
    <div class="form-row">
      <label>Speaking Time:</label>
      <input type="number" id="rr-speak-m" min="0" max="99" placeholder="0">
      <span class="time-sep">m</span>
      <input type="number" id="rr-speak-s" min="0" max="59" placeholder="0">
      <span class="time-label">s</span>
    </div>
    <div class="error-msg" id="rr-error">Please fill in valid values.</div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="startRR()">Submit</button>
      <button class="btn btn-muted" onclick="goHome()">← Back</button>
    </div>
  </div>
</div>

<div class="page" id="page-rr-timer">
  <div class="card fade-in">
    <div class="card-title">Speaker's List</div>
    <span id="rr-topic-tag" class="topic-tag"></span>
    <div class="speaker-row">
      <span class="speaker-num" id="rr-speaker-num">—</span>
      <span class="speaker-lbl" id="rr-speaker-label">Speaker</span>
    </div>
    <div class="timer-layout">
      <div class="timer-display">
        <div class="timer-speaker">Speaking Time</div>
        <div class="timer-count" id="rr-speak-display">01:00</div>
        <div class="timer-status paused" id="rr-speak-status">Paused</div>
      </div>
      <div class="timer-btn-col">
        <button class="btn btn-primary" id="rr-start-btn" onclick="toggleRR()">Start</button>
        <button class="btn btn-muted" onclick="resetRRSpeaker()">Reset</button>
        <button class="btn btn-green" onclick="nextRRSpeaker()">Next ›</button>
        <button class="btn btn-muted" onclick="newCaucus()">↩ New</button>
      </div>
    </div>
  </div>
</div>

<script>
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const t = document.getElementById(id);
  t.classList.add('active');
  const c = t.querySelector('.card');
  if (c) { c.classList.remove('fade-in'); void c.offsetWidth; c.classList.add('fade-in'); }
}

// Input clearning
function clearInputs() {
  document.querySelectorAll('input').forEach(input => {
    input.value = '';
  });
  document.querySelectorAll('.error-msg').forEach(err => {
    err.style.display = 'none';
  });
}

function goHome() {
  clearInputs();
  showPage('page-home');
}

function newCaucus() { 
  clearAllTimers(); 
  clearInputs();
  document.getElementById('mod-speak-display').classList.remove('critical-time');
  document.getElementById('unmod-display').classList.remove('critical-time');
  document.getElementById('rr-speak-display').classList.remove('critical-time');
  showPage('page-home'); 
}

function clearAllTimers() {
  clearInterval(modInterval);
  clearInterval(unmodInterval);
  clearInterval(rrInterval);
  modInterval = unmodInterval = rrInterval = null;
}

function pad(n) { return String(n).padStart(2, '0'); }
function fmt(s) { return pad(Math.floor(s / 60)) + ':' + pad(s % 60); }
function setStatus(id, text, cls) {
  const e = document.getElementById(id);
  e.textContent = text;
  e.className = 'timer-status ' + cls;
}

// ── MODERATED CAUCUS ──
let modTotalSecs, modTotalRemain, modSpeakSecs, modSpeakRemain;
let modCurrentSpeaker, modTotalSpeakers;
let modRunning = false, modInterval = null;
let modSpentThisTurn = 0; 

function startModerated() {
  const topic = document.getElementById('mod-topic').value.trim();
  const tm = parseInt(document.getElementById('mod-total-m').value) || 0;
  const ts = parseInt(document.getElementById('mod-total-s').value) || 0;
  const sm = parseInt(document.getElementById('mod-speak-m').value) || 0;
  const ss = parseInt(document.getElementById('mod-speak-s').value) || 0;
  modTotalSecs = tm * 60 + ts;
  modSpeakSecs = sm * 60 + ss;
  const err = document.getElementById('mod-error');
  if (modTotalSecs <= 0 || modSpeakSecs <= 0) { err.style.display = 'block'; return; }
  err.style.display = 'none';
  
  modTotalRemain = modTotalSecs;
  modSpeakRemain = modSpeakSecs;
  modSpentThisTurn = 0; 
  modCurrentSpeaker = 1;
  modTotalSpeakers = Math.floor(modTotalSecs / modSpeakSecs);
  modRunning = false;
  clearInterval(modInterval);
  
  const display = document.getElementById('mod-speak-display');
  display.classList.remove('critical-time');
  display.textContent = fmt(modSpeakRemain);
  
  document.getElementById('mod-topic-tag').textContent = topic || 'No Topic';
  setStatus('mod-speak-status', 'Paused', 'paused');
  document.getElementById('mod-start-btn').textContent = 'Start';
  updateModInfo();
  showPage('page-mod-timer');
}

function updateModInfo() {
  document.getElementById('mod-speaker-num').textContent = modCurrentSpeaker;
  document.getElementById('mod-speaker-label').textContent = 'Speaker ' + modCurrentSpeaker + ' of ' + modTotalSpeakers;
}

function toggleModTimer() {
  const display = document.getElementById('mod-speak-display');
  if (modRunning) {
    clearInterval(modInterval);
    modRunning = false;
    document.getElementById('mod-start-btn').textContent = 'Start';
    setStatus('mod-speak-status', 'Paused', 'paused');
  } else {
    if (modSpeakRemain <= 0 || modTotalRemain <= 0) return;
    modRunning = true;
    document.getElementById('mod-start-btn').textContent = 'Pause';
    setStatus('mod-speak-status', 'Running', 'running');
    
    modInterval = setInterval(() => {
      modSpeakRemain--;
      modTotalRemain--;
      modSpentThisTurn++; 
      
      display.textContent = fmt(modSpeakRemain);

      if (modSpeakRemain <= 5 && modSpeakRemain > 0) {
        display.classList.add('critical-time');
      } else {
        display.classList.remove('critical-time');
      }

      if (modSpeakRemain <= 0 || modTotalRemain <= 0) {
        clearInterval(modInterval);
        display.classList.remove('critical-time');
        modRunning = false;
        document.getElementById('mod-start-btn').textContent = 'Start';
        setStatus('mod-speak-status', modTotalRemain <= 0 ? 'Caucus Ended' : 'Time Up', 'done');
      }
    }, 1000);
  }
}

function resetModSpeaker() {
  clearInterval(modInterval);
  modRunning = false;
  modTotalRemain += modSpentThisTurn;
  modSpentThisTurn = 0; 
  modSpeakRemain = modSpeakSecs;
  const display = document.getElementById('mod-speak-display');
  display.textContent = fmt(modSpeakRemain);
  display.classList.remove('critical-time');
  setStatus('mod-speak-status', 'Paused', 'paused');
  document.getElementById('mod-start-btn').textContent = 'Start';
}

function nextModSpeaker() {
  if (modCurrentSpeaker >= modTotalSpeakers || modTotalRemain <= 0) {
    setStatus('mod-speak-status', 'Caucus Ended', 'done');
    clearInterval(modInterval);
    modRunning = false;
    document.getElementById('mod-start-btn').textContent = 'Start';
    return;
  }
  clearInterval(modInterval);
  modRunning = false;
  modCurrentSpeaker++;
  modSpentThisTurn = 0; 
  modSpeakRemain = Math.min(modSpeakSecs, modTotalRemain);
  const display = document.getElementById('mod-speak-display');
  display.textContent = fmt(modSpeakRemain);
  display.classList.remove('critical-time');
  setStatus('mod-speak-status', 'Paused', 'paused');
  document.getElementById('mod-start-btn').textContent = 'Start';
  updateModInfo();
}

// ── UNMODERATED CAUCUS ──
let unmodTotalSecs, unmodRemain;
let unmodRunning = false, unmodInterval = null;

function startUnmod() {
  const m = parseInt(document.getElementById('unmod-m').value) || 0;
  const s = parseInt(document.getElementById('unmod-s').value) || 0;
  unmodTotalSecs = m * 60 + s;
  const err = document.getElementById('unmod-error');
  if (unmodTotalSecs <= 0) { err.style.display = 'block'; return; }
  err.style.display = 'none';
  unmodRemain = unmodTotalSecs;
  unmodRunning = false;
  clearInterval(unmodInterval);
  const display = document.getElementById('unmod-display');
  display.textContent = fmt(unmodRemain);
  display.classList.remove('critical-time');
  setStatus('unmod-status', 'Paused', 'paused');
  document.getElementById('unmod-start-btn').textContent = 'Start';
  showPage('page-unmod-timer');
}

function toggleUnmod() {
  const display = document.getElementById('unmod-display');
  if (unmodRunning) {
    clearInterval(unmodInterval);
    unmodRunning = false;
    document.getElementById('unmod-start-btn').textContent = 'Start';
    setStatus('unmod-status', 'Paused', 'paused');
  } else {
    if (unmodRemain <= 0) return;
    unmodRunning = true;
    document.getElementById('unmod-start-btn').textContent = 'Pause';
    setStatus('unmod-status', 'Running', 'running');
    unmodInterval = setInterval(() => {
      unmodRemain--;
      display.textContent = fmt(unmodRemain);

      if (unmodRemain <= 5 && unmodRemain > 0) {
        display.classList.add('critical-time');
      } else {
        display.classList.remove('critical-time');
      }

      if (unmodRemain <= 0) {
        clearInterval(unmodInterval);
        display.classList.remove('critical-time');
        unmodRunning = false;
        document.getElementById('unmod-start-btn').textContent = 'Start';
        setStatus('unmod-status', 'Time Expired', 'done');
      }
    }, 1000);
  }
}

function resetUnmod() {
  clearInterval(unmodInterval);
  unmodRunning = false;
  unmodRemain = unmodTotalSecs;
  const display = document.getElementById('unmod-display');
  display.textContent = fmt(unmodRemain);
  display.classList.remove('critical-time');
  setStatus('unmod-status', 'Paused', 'paused');
  document.getElementById('unmod-start-btn').textContent = 'Start';
}

// ── ROUND ROBIN / SPEAKER'S LIST ──
let rrSpeakSecs, rrSpeakRemain, rrCurrentSpeaker, rrTotalSpeakers;
let rrRunning = false, rrInterval = null;

function startRR() {
  const topic = document.getElementById('rr-topic').value.trim();
  const speakers = parseInt(document.getElementById('rr-speakers').value) || 0;
  const sm = parseInt(document.getElementById('rr-speak-m').value) || 0;
  const ss = parseInt(document.getElementById('rr-speak-s').value) || 0;
  rrSpeakSecs = sm * 60 + ss;
  const err = document.getElementById('rr-error');
  if (rrSpeakSecs <= 0 || speakers <= 0) { err.style.display = 'block'; return; }
  err.style.display = 'none';
  rrTotalSpeakers = speakers;
  rrCurrentSpeaker = 1;
  rrSpeakRemain = rrSpeakSecs;
  rrRunning = false;
  clearInterval(rrInterval);
  const display = document.getElementById('rr-speak-display');
  display.textContent = fmt(rrSpeakRemain);
  display.classList.remove('critical-time');
  document.getElementById('rr-topic-tag').textContent = topic || 'No Topic';
  setStatus('rr-speak-status', 'Paused', 'paused');
  document.getElementById('rr-start-btn').textContent = 'Start';
  updateRRInfo();
  showPage('page-rr-timer');
}

function updateRRInfo() {
  document.getElementById('rr-speaker-num').textContent = rrCurrentSpeaker;
  document.getElementById('rr-speaker-label').textContent = 'Speaker ' + rrCurrentSpeaker + ' of ' + rrTotalSpeakers;
}

function toggleRR() {
  const display = document.getElementById('rr-speak-display');
  if (rrRunning) {
    clearInterval(rrInterval);
    rrRunning = false;
    document.getElementById('rr-start-btn').textContent = 'Start';
    setStatus('rr-speak-status', 'Paused', 'paused');
  } else {
    if (rrSpeakRemain <= 0) return;
    rrRunning = true;
    document.getElementById('rr-start-btn').textContent = 'Pause';
    setStatus('rr-speak-status', 'Running', 'running');
    rrInterval = setInterval(() => {
      rrSpeakRemain--;
      display.textContent = fmt(rrSpeakRemain);

      if (rrSpeakRemain <= 5 && rrSpeakRemain > 0) {
        display.classList.add('critical-time');
      } else {
        display.classList.remove('critical-time');
      }

      if (rrSpeakRemain <= 0) {
        clearInterval(rrInterval);
        display.classList.remove('critical-time');
        rrRunning = false;
        document.getElementById('rr-start-btn').textContent = 'Start';
        setStatus('rr-speak-status', 'Time Up', 'done');
      }
    }, 1000);
  }
}

function resetRRSpeaker() {
  clearInterval(rrInterval);
  rrRunning = false;
  rrSpeakRemain = rrSpeakSecs;
  const display = document.getElementById('rr-speak-display');
  display.textContent = fmt(rrSpeakRemain);
  display.classList.remove('critical-time');
  setStatus('rr-speak-status', 'Paused', 'paused');
  document.getElementById('rr-start-btn').textContent = 'Start';
}

function nextRRSpeaker() {
  if (rrCurrentSpeaker >= rrTotalSpeakers) {
    setStatus('rr-speak-status', 'All Done', 'done');
    clearInterval(rrInterval);
    rrRunning = false;
    document.getElementById('rr-start-btn').textContent = 'Start';
    return;
  }
  clearInterval(rrInterval);
  rrRunning = false;
  rrCurrentSpeaker++;
  rrSpeakRemain = rrSpeakSecs;
  const display = document.getElementById('rr-speak-display');
  display.textContent = fmt(rrSpeakRemain);
  display.classList.remove('critical-time');
  setStatus('rr-speak-status', 'Paused', 'paused');
  document.getElementById('rr-start-btn').textContent = 'Start';
  updateRRInfo();
}

// ── hotkeys ──
document.addEventListener('keydown', function(e) {
  if (e.target.tagName === 'INPUT') return;
  
  const activePage = document.querySelector('.page.active')?.id;
  const key = e.key.toLowerCase();
  
  if (e.code === 'Space') {
    e.preventDefault();
    if (activePage === 'page-mod-timer') toggleModTimer();
    if (activePage === 'page-unmod-timer') toggleUnmod();
    if (activePage === 'page-rr-timer') toggleRR();
  }

  if (key === 'n') {
    if (activePage === 'page-mod-timer') nextModSpeaker();
    if (activePage === 'page-rr-timer') nextRRSpeaker();
  }

  if (key === 'r') {
    if (activePage === 'page-mod-timer') resetModSpeaker();
    if (activePage === 'page-unmod-timer') resetUnmod();
    if (activePage === 'page-rr-timer') resetRRSpeaker();
  }
  
  if (e.key === 'Escape') {
    newCaucus();
  }
});

</script>
